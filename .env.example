# ---- MongoDB (your Atlas free tier) ----
# Get this from Atlas → Connect → Drivers. Add /signature before the ?
DATABASE_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/signature?retryWrites=true&w=majority

# ---- Payload ----
# Any random 32+ char string. Generate: openssl rand -base64 32
PAYLOAD_SECRET=replace-with-a-long-random-secret

# ---- URLs ----
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- S3 (LATER — leave blank until you migrate off local disk) ----
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
